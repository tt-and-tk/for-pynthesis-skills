{
  "extraKnownMarketplaces": {
    "for-pynthesis-skills": {
      "source": {
        "source": "github",
        "repo": "tt-and-tk/for-pynthesis-skills"
      }
    }
  },
  "enabledPlugins": {
    "for-pynthesis-skills@for-pynthesis-skills": true
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Edit(/**/.claude/settings*.json)",
      "Edit(/**/.claude/hooks/**)",
      "Edit(/**/.claude-plugin/**)",
      "Edit(/**/hooks/**)",
      "Edit(/**/.mcp.json)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Edit(/**/.git)",
      "Edit(/**/.git/**)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue close:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
